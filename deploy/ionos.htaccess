# Static La Dolce Isola site on IONOS managed Apache webspace.
# Connect the future domain to /public/la-dolce-isola (SFTP).
# No domain or HTTPS redirect until the domain and certificate are configured.
Options -Indexes
DirectoryIndex index.html

<FilesMatch "(?i)(^\.|\.(?:env|ini|log|bak|sql|map|md|ya?ml|pem|key)$|^(?:package(?:-lock)?\.json|CNAME)$)">
    Require all denied
</FilesMatch>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    <FilesMatch "\.(?:html|json)$">
        Header set Cache-Control "no-cache"
    </FilesMatch>
</IfModule>
